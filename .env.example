# Cle Jev : UNE des deux suffit.
#
# OpenRouter (inscription libre, meme contrat, meme prix) :
OPENROUTER_API_KEY=
#
# TypeSafe en direct (acces anticipe, inscriptions parfois fermees) :
TYPESAFE_API_KEY=

# Facultatif. Sans cela, le fournisseur est deduit de la cle presente,
# TypeSafe d'abord. Valeurs : typesafe | openrouter
# JEVSEO_PROVIDER=openrouter

# Facultatif. Surcharge le modele. Par defaut : jev-latest en direct,
# typesafe/jev-1.13 via OpenRouter (version figee = audits reproductibles).
# JEVSEO_MODEL=typesafe/jev-1.13

# Facultatif. Langue des questions envoyees a Jev : en (defaut) | fr
# La doc TypeSafe donne l'anglais comme langue la plus forte du modele ;
# le contenu juge reste francais dans les deux cas. A trancher par mesure.
# JEVSEO_QUESTIONS_LANG=fr

PAGESPEED_API_KEY=
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
